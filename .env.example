# Server-side only. Never prefix these values with VITE_ or commit real secrets.
MS_GRAPH_TENANT_ID=your-microsoft-tenant-id
MS_GRAPH_CLIENT_ID=your-app-registration-client-id
MS_GRAPH_CLIENT_SECRET=your-app-registration-client-secret
QUOTE_ALLOWED_ORIGINS=https://greenflownurseries.com,https://www.greenflownurseries.com

# Optional when the API is hosted separately from the Vite site.
VITE_QUOTE_API_URL=/api/quote

# Alternative Resend implementation. Use a different free Resend account and
# verified domain for each website. These values are server-side except VITE_*.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=info@gfnplants.ca
RESEND_FROM_NAME=Green Flow Nurseries
QUOTE_RECIPIENT_EMAIL=info@gfnplants.ca
VITE_RESEND_QUOTE_API_URL=/api/quote-resend
